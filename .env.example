# Copy to .env (never commit .env) or set these in your shell.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_FALLBACK_MODEL=gpt-6-luna
# ADVISOR_LLM=none                 # force deterministic answers (no API calls)
# OPENAI_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible server, e.g. Ollama (free, local)
# ADVISOR_FORECAST_SOURCE=reference           # use the organisers' reference forecast instead of ours
# REFERENCE_FORECAST_PATH=reference/reference_forecast.csv
